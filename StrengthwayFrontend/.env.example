VITE_API_BASE_URL=http://localhost:5000/api

# Set to false — the backend is live and handles all business data.
# Demo mode allowed login without a backend; it is no longer needed.
VITE_DEMO_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# Client-side localStorage keys (preferences + auth session only)
# Business data (members, trainers, batches, plans, schedules, inquiries)
# is now persisted in MongoDB via the backend — NOT in localStorage.
# ─────────────────────────────────────────────────────────────────────────────
VITE_STORAGE_KEY_THEME=theme
VITE_STORAGE_KEY_AUTH_TOKEN=tsw-token
VITE_STORAGE_KEY_AUTH_USER=tsw-user
