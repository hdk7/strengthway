# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ────────────────────────────────────────────
# Replace <user>, <password>, and <cluster> with your Atlas credentials
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/strengthwaydb?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# ─── Cloudinary (for photo / document uploads) ────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── CORS ─────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────
# 900000ms = 15 minutes window, 200 requests max per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── Meta WhatsApp Business Cloud API ──────────────────────────
# Official Meta Developer App & WhatsApp Business Platform Credentials
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verification_token_here
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_PAYMENT_TEMPLATE_NAME=membership_payment_link
WHATSAPP_PAYMENT_TEMPLATE_LANG=en_US
GYM_NAME=Strengthway Gym

# ─── Razorpay Payment Gateway ─────────────────────────────────
# Official Razorpay API keys and Webhook secret
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

