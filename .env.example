VITE_API_BASE_URL=http://localhost:5000/api

# Demo mode lets the admin login form work without a backend, using a hardcoded
# credential pair. Set to false (or remove) once VITE_API_BASE_URL is live.
VITE_DEMO_MODE=true

# ─────────────────────────────────────────────────────────────────────────────
# LocalStorage Keys Configuration
# Centrally managed environment variables for browser persistence keys.
# ─────────────────────────────────────────────────────────────────────────────
VITE_STORAGE_KEY_THEME=theme
VITE_STORAGE_KEY_AUTH_TOKEN=tsw-token
VITE_STORAGE_KEY_AUTH_USER=tsw-user
VITE_STORAGE_KEY_INQUIRIES=thestrengthway_inquiries_data_v1
VITE_STORAGE_KEY_TRAINERS=tsw-trainers
VITE_STORAGE_KEY_MEMBERS=tsw-registered-members
VITE_STORAGE_KEY_BATCHES=tsw-batches
VITE_STORAGE_KEY_COACH_SHIFTS=tsw-coach-shifts
VITE_STORAGE_KEY_SCHEDULED_CLASSES=tsw-scheduled-classes
VITE_STORAGE_KEY_MASTER_SCHEDULES=tsw-master-class-schedules
VITE_STORAGE_KEY_MASTER_ITEMS=tsw-master-class-items
VITE_STORAGE_KEY_SESSIONS=tsw-generated-sessions
VITE_STORAGE_KEY_HOLIDAYS=tsw-holidays
VITE_STORAGE_KEY_CURRICULUM_VERSION=tsw-curriculum-version
VITE_STORAGE_KEY_MEMBERSHIP_PLANS=thestrengthway_membership_plans_v1
